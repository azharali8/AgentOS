# AgentOS Environment Configuration Template
# Copy this file to .env and fill in your values

# Workspace Root
# WORKSPACE_ROOT=C:\path\to\your\workspace

# LLM Configuration
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Authentication & Security
AUTH_ENABLED=false
JWT_SECRET=agentos-default-jwt-secret-change-in-prod
API_KEY_SALT=agentos-default-salt-change-in-prod

# Voice Agent & AssemblyAI Speech-to-Text
# Get your AssemblyAI API key from https://www.assemblyai.com/
ASSEMBLYAI_API_KEY=83638040041147eb8e24edbba74d886c
VOICE_PROVIDER=assemblyai
VOICE_TTS_PROVIDER=browser
VOICE_MAX_AUDIO_SIZE_BYTES=15728640
VOICE_TIMEOUT_SECONDS=60

# Distributed Queue & Persistence (Phase 16)
QUEUE_BACKEND=sqlite
RATE_LIMIT_BACKEND=memory
EVENT_BACKEND=db
REDIS_URL=redis://localhost:6379/0
